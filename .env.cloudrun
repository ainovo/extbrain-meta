# Locked-model edition for the Cloud Run deployment.
# Build with: npm run build:cloudrun  (== vite build --mode cloudrun)
# The default `npm run build` ignores this file, so local builds stay unlocked.
VITE_LOCK_MODELS=1
VITE_LOCKED_META_MODEL=muse-spark-1.3-contributor
VITE_LOCKED_NER_BACKEND=modal
VITE_LOCKED_NLI_BACKEND=modal
