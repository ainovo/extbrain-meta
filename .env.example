# Meta Model API key for the ExtBrain backend.
# Create one at https://dev.meta.ai (Model API dashboard → API keys tab).
# Keys start with LLM_. Copy this file to .env and fill in your key.
MODEL_API_KEY=

# Modal-hosted NER+NLI (Settings → Mentions/tags backends). Required only
# when a Modal backend is selected; the Load page holds until these are set.
# MODAL_ANALYZE_URL is the full deployed endpoint URL, including /analyze
# (printed by `modal deploy modal/modal_deploy.py`). EXTBRAIN_API_SECRET must
# match the value in the Modal extbrain-auth secret (same name both sides).
MODAL_ANALYZE_URL=
EXTBRAIN_API_SECRET=

# Public deployments (e.g. Cloud Run): comma-separated browser origins allowed
# to call the API. Unset means allow-all (local development only); the server
# logs a warning in production when this is missing.
# CORS_ORIGINS=https://app.extbrain.ai

# Per-IP rate limits over a 15-minute window (per server instance).
# API-wide cap for all /api routes, plus a stricter cap for the endpoints
# that spend Meta API quota. 0 disables that limiter.
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_GEN_MAX=60

# Consent + metering store (MongoDB). The server logs onboarding consent,
# per-visit heartbeats, and per-call model spend to these collections:
#   users    { _id: userId, consentAt, lastVisited }
#   metering { userId, ts, kind, model, backend, inputTokens, outputTokens,
#              durationMs, costUsd }
# Unset MONGODB_URI to disable (local development): the server warns once
# and every metering call becomes a no-op so requests never fail.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/extbrain
# MONGODB_DB=extbrain

# Hardening for public deployments (Cloud Run). The Settings UI locks are
# cosmetic — these env vars enforce them server-side, where curl cannot
# bypass them. Leave all three unset for local development.
# Comma-separated Meta model ids allowed in API calls (requests for any
# other model get a 403). Locked Cloud Run value:
# ALLOWED_META_MODELS=muse-spark-1.3-contributor
# Secret required in the X-Admin-Key header for POST/DELETE /api/costs.
# Unset = anyone can edit rates (fine for local single-user use).
# ADMIN_API_KEY=
# Set to 1 to ignore the X-Metering-Opt-Out header (mandatory metering).
# METERING_ENFORCED=1
# Set to 1 to not deploy the cost-table API at all (Cloud Run): every
# /api/costs method then 404s as if the endpoints never existed. Use this
# when rates are fixed and never edited in prod.
# DISABLE_COSTS_API=1
# Set to 1 when the connection string points at Firestore's
# MongoDB-compatible endpoint (or any store where the app identity may not
# create indexes). The app then skips createIndex; create the
# metering { userId: 1, ts: -1 } index out-of-band instead, e.g.:
# gcloud firestore indexes composite create --project=extbrain-512816 \
#   --database=extbrain --collection-group=metering \
#   --field-config=field-path=userId,order=ascending \
#   --field-config=field-path=ts,order=descending
# MONGO_SKIP_INDEXES=1
