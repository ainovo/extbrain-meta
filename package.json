{
  "name": "takeout-project-summarizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --port 5173",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:cloudrun": "tsc -b && vite build --mode cloudrun",
    "prepare:ner": "python3 scripts/prepare_xlm_ner.py",
    "start": "tsx server/index.ts",
    "test": "tsx tests/test_parser_packer.ts && tsx tests/test_voice_endpoint.ts && tsx tests/test_tag_filter_display.ts && tsx tests/test_modal_backends.ts && tsx tests/test_auto_start.ts && tsx tests/test_rate_limit.ts && tsx tests/test_metering_costs.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "marked": "^15.0.12",
    "mongodb": "^7.8.0",
    "pako": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
